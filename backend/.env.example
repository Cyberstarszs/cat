# ==============================================================================
# CAT GOVERNANCE - Environment Configuration Example
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cat_governance?schema=public

# Database Pool Concurrency Tuning
# - Sesi Kecil (<= 50 peserta): DB_POOL_MAX=20
# - Sesi Menengah (50 - 150 peserta): DB_POOL_MAX=50 (Default)
# - Sesi Massal Konkuren (> 300 peserta di banyak lab): DB_POOL_MAX=100 - 150
DB_POOL_MAX=50
DB_POOL_MIN=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Application Secret Key (Minimum 32 characters for cookie & token signature)
APP_SECRET=c4t_g0v3rn4nc3_sup3r_s3cr3t_k3y_f1a_2026_m1n_32_ch4rs

# Public Base URL (Used for QR Code Verification & Certificates)
BASE_URL=http://localhost:3000

# Set to true only if accessing through valid HTTPS in production
COOKIE_SECURE=false

# Initial Seed Administrator Credentials (FR-A08)
ADMIN_EMAIL=admin@fia.kampus.ac.id
ADMIN_PASSWORD=AdminPassword123!
