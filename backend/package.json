{
  "name": "governance",
  "version": "1.0.0",
  "description": "================================================================================\r SPESIFIKASI KEBUTUHAN PERANGKAT LUNAK (SRS)\r CAT GOVERNANCE - Sistem Uji Kompetensi Umum Fakultas Ilmu Administrasi (FIA)\r ================================================================================",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "build": "prisma generate && tsc && node -e \"import('fs').then(fs => fs.cpSync('src/db/migrations', 'dist/db/migrations', {recursive:true, force:true}))\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrator.ts",
    "seed:admin": "tsx src/db/seeds/seed-admin.ts",
    "seed:questions": "tsx src/db/seeds/seed-questions.ts",
    "seed": "tsx src/db/seeds/seed-admin.ts && tsx src/db/seeds/seed-questions.ts",
    "db:clean": "tsx src/db/clean.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/bcrypt": "^2.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "kysely": "^0.28.17",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
